# SQLite is used for local dev (zero-config). For production, point this at a
# PostgreSQL connection string (Supabase, Vercel Postgres, Neon, etc.) and
# swap the adapter in src/lib/prisma.ts from @prisma/adapter-better-sqlite3 to
# @prisma/adapter-pg — see README "Deploying to production".
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-secret"
NEXTAUTH_URL="http://localhost:3001"
